# Signs.nl raamfolie — omgevingsvariabelen
# Kopieer dit bestand naar .env.local en vul de waarden in.

# Prisma database-connectie.
# Lokaal (SQLite): file:./prisma/dev.db   —   Productie: Postgres-URL.
DATABASE_URL="file:./prisma/dev.db"

# Resend API-key. Leeg laten = e-mails worden ge-console.log't i.p.v. verstuurd.
RESEND_API_KEY=

# Afzender van e-mails. Tot signs.nl geverifieerd is bij Resend: onboarding@resend.dev
FROM_EMAIL=

# E-mailadres waar Mo de meldingen van nieuwe aanvragen ontvangt.
NOTIFICATION_EMAIL=

# Basis-URL voor de offertelinks in e-mails. Moet gelijk zijn aan de gedeployde URL.
BASE_URL=http://localhost:3000

# Gedeeld wachtwoord voor /admin.
ADMIN_PASSWORD=

# 32+ tekens willekeurig, voor HMAC-ondertekening van de admin-sessie.
# Genereer met: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# WhatsApp Business API — later (zie README → Known limitations).
# WHATSAPP_API_KEY=
