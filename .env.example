# Kopieer dit bestand naar .env en vul de waarden in.

# DATABASE_URL is already set by prisma init — lokale SQLite-database.
DATABASE_URL="file:./prisma/dev.db"

# RESEND_API_KEY=re_xxx           — get from resend.com dashboard
# FROM_EMAIL=offerte@signs.nl     — must be verified domain in Resend
# NOTIFICATION_EMAIL=mo@signs.nl  — where Mo gets notifications
# BASE_URL=http://localhost:3000  — for offerte links in emails

# ADMIN_PASSWORD=          — single shared password for /admin
# ADMIN_SESSION_SECRET=    — random string (32+ chars) for cookie signing

# WHATSAPP_API_KEY=      # later — WhatsApp Business
